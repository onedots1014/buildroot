# STM32MP157 rootfs-only buildroot config (Role C).
# ATF / U-Boot / Linux / M4 come from the top-level build.sh; this config
# is responsible only for producing rootfs.ext4 with a usable userspace.
#
# Kernel modules and M4 firmware ELFs are injected by post-build.sh
# from $OUTPUT_DIR/modules_install and $OUTPUT_DIR/m4.

# Target architecture
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_VFPV4=y

# Toolchain (internal, glibc for compatibility with openssh/python/curl)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_5_4=y

# Init / system
BR2_INIT_BUSYBOX=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_TARGET_GENERIC_HOSTNAME="stm32mp157"
BR2_TARGET_GENERIC_ISSUE="Welcome to STM32MP157 (buildroot rootfs)"
BR2_TARGET_GENERIC_GETTY_PORT="ttySTM0"

# Rootfs image
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set

# Inject M4 firmware + kernel modules from the BSP build
BR2_ROOTFS_POST_BUILD_SCRIPT="board/onedots/stm32mp157-onedots/scripts/post-build.sh"

# ----------------------------------------------------------------------------
# Packages — network basics (SSH on, network usable, can fetch over HTTPS)
# ----------------------------------------------------------------------------
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_TLS_OPENSSL=y

# ----------------------------------------------------------------------------
# Packages — package manager (opkg, for on-device install)
# ----------------------------------------------------------------------------
BR2_PACKAGE_OPKG=y

# ----------------------------------------------------------------------------
# Packages — Python 3 (with pip via ensurepip)
# ----------------------------------------------------------------------------
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_PIP=y

# ----------------------------------------------------------------------------
# Packages — debug trinity
# ----------------------------------------------------------------------------
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_TCPDUMP=y
